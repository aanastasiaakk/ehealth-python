    {
      "id": 5,
      "type": "timeseries",
      "title": "Пропускна здатність",
      "description": "Запити за секунду: усього і по кожній репліці (рівномірність балансування)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"ehealth-app\"}[1m]))",
          "legendFormat": "усього"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (instance) (rate(http_requests_total{job=\"ehealth-app\"}[1m]))",
          "legendFormat": "{{instance}}"
