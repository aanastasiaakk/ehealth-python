# ============ РОБОЧЕ СЕРЕДОВИЩЕ (PRODUCTION) ============
# Скопіюй:  cp .env.production.example .env.production
# і ОБОВ'ЯЗКОВО заміни всі значення з позначкою CHANGE-ME.
# Файл .env.production НЕ потрапляє в Git (див. .gitignore).
APP_ENV=production
APP_NAME="e-Health Booking"

# Відладка ВИМКНЕНА: користувач не бачить стектрейсів.
# Якщо поставити true, застосунок відмовиться запускатися.
DEBUG=false
# Swagger (/docs) у production приховано
DOCS_ENABLED=false

# Окрема база — контейнер db-production, порт 5434.
# Пароль має збігатися з POSTGRES_PASSWORD_PROD у файлі .env (для docker compose).
DATABASE_URL=postgresql+psycopg://ehealth_prod:CHANGE-ME-db-password@localhost:5434/ehealth_production

# ОБОВ'ЯЗКОВО згенеруй новий ключ (мінімум 32 символи):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-generate-a-real-secret-key-0000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

ADMIN_EMAIL=admin@ehealth.ua
ADMIN_PASSWORD=CHANGE-ME-strong-admin-password
