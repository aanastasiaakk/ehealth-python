# Скопіюй цей файл у .env:  cp .env.example .env
# Файл .env не потрапляє в Git (див. .gitignore), бо там можуть бути паролі.
APP_NAME="e-Health Booking"
DEBUG=false
DATABASE_URL=postgresql+psycopg://ehealth:ehealth@localhost:5432/ehealth

# Секретний ключ для підпису JWT. Для реального сервера згенеруй новий:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-in-production-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Перший адміністратор (створюється командою: python -m scripts.seed)
ADMIN_EMAIL=admin@ehealth.ua
ADMIN_PASSWORD=admin12345
