# Віртуальне оточення Python
.venv/
venv/

# Секрети: справжні файли середовищ НІКОЛИ не комітимо,
# лише шаблони *.example
.env
.env.*
!.env.example
!.env.*.example

# Кеш Python та інструментів
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Системні файли macOS та редакторів
.DS_Store
.vscode/
.idea/

# HTML-звіти Locust (~1 МБ, генеруються при кожному запуску)
loadtest/results/*.html

# Локальні файли Redis і результати перевірок, що генеруються
dump.rdb
