# ============ ТЕСТОВЕ СЕРЕДОВИЩЕ (SANDBOX) ============
# Скопіюй:  cp .env.sandbox.example .env.sandbox
# Файл .env.sandbox НЕ потрапляє в Git (див. .gitignore).
APP_ENV=sandbox
APP_NAME="e-Health Booking [SANDBOX]"

# Відладка ввімкнена: детальні помилки зі стектрейсом і SQL у консолі
DEBUG=true
DOCS_ENABLED=true

# Окрема база для тестів — контейнер db-sandbox, порт 5433
DATABASE_URL=postgresql+psycopg://ehealth_sandbox:sandbox_pass@localhost:5433/ehealth_sandbox

# Згенеруй свій ключ: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sandbox-only-secret-key-not-for-production-0001
ACCESS_TOKEN_EXPIRE_MINUTES=120

ADMIN_EMAIL=admin@ehealth.ua
ADMIN_PASSWORD=admin12345
